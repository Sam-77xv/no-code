# =============================================================================
# ClipForge Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control

# =============================================================================
# Application Settings
# =============================================================================
NODE_ENV=development
PORT=3000

# =============================================================================
# Paths
# =============================================================================
# Directory for downloaded videos
DOWNLOAD_PATH=./data/downloads

# Directory for processed videos ready for upload
UPLOAD_PATH=./data/uploads

# Directory for logs
LOG_PATH=./data/logs

# Directory for temporary files
TEMP_PATH=./data/temp

# =============================================================================
# yt-dlp Configuration
# =============================================================================
# Path to yt-dlp executable (leave empty to use system installation)
YTDLP_PATH=

# yt-dlp additional arguments
YTDLP_ARGS=--quiet --no-warnings

# =============================================================================
# FFmpeg Configuration
# =============================================================================
# Path to FFmpeg executable (leave empty to use system installation)
FFMPEG_PATH=

# FFmpeg additional arguments
FFMPEG_ARGS=

# =============================================================================
# Redis Configuration (for BullMQ queue)
# =============================================================================
# Redis host (leave as localhost for local development)
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis database number
REDIS_DB=0

# =============================================================================
# Database Configuration (SQLite)
# =============================================================================
# SQLite database path
DATABASE_URL=file:./data/clipforge.db

# =============================================================================
# OAuth 2.0 API Keys and Secrets
# =============================================================================
# Get these from each platform's developer portal

# YouTube Data API v3
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback

# Instagram Graph API (Meta)
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# Facebook Graph API (Meta)
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# X/Twitter API v2
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/twitter/callback

# LinkedIn Marketing API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Threads API
THREADS_CLIENT_ID=your_threads_client_id
THREADS_CLIENT_SECRET=your_threads_client_secret
THREADS_REDIRECT_URI=http://localhost:3000/api/auth/threads/callback

# Snapchat Spotlight (Snap Kit)
SNAPCHAT_CLIENT_ID=your_snapchat_client_id
SNAPCHAT_CLIENT_SECRET=your_snapchat_client_secret
SNAPCHAT_REDIRECT_URI=http://localhost:3000/api/auth/snapchat/callback

# Pinterest API v5
PINTEREST_CLIENT_ID=your_pinterest_client_id
PINTEREST_CLIENT_SECRET=your_pinterest_client_secret
PINTEREST_REDIRECT_URI=http://localhost:3000/api/auth/pinterest/callback

# =============================================================================
# AI API Keys
# =============================================================================
# OpenAI API
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Anthropic Claude API
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-3-sonnet-20240229

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# =============================================================================
# Authentication Encryption
# =============================================================================
# Encryption key for secure token storage (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your_32_byte_base64_encryption_key

# =============================================================================
# Application Settings
# =============================================================================
# Maximum number of retry attempts
MAX_RETRIES=5

# Base delay for exponential backoff (milliseconds)
RETRY_BASE_DELAY=1000

# Maximum delay for exponential backoff (milliseconds)
RETRY_MAX_DELAY=30000

# Jitter factor for retry delays (0-1)
RETRY_JITTER_FACTOR=0.1

# =============================================================================
# Video Processing Settings
# =============================================================================
# Default compression preset (low, medium, high)
DEFAULT_COMPRESSION=medium

# Default aspect ratio (9:16, 16:9, 1:1, 4:5)
DEFAULT_ASPECT_RATIO=9:16

# Enable smart cropping (face/subject tracking)
SMART_CROP_ENABLED=true

# Enable watermark removal
WATERMARK_REMOVAL_ENABLED=false

# Split long videos into <=60s clips
SPLIT_LONG_VIDEOS=true

# Maximum video duration for splitting (seconds)
MAX_VIDEO_DURATION=60

# =============================================================================
# Rate Limiting Settings
# =============================================================================
# Override platform rate limits (requests per minute)
# YOUTUBE_RATE_LIMIT=100
# TIKTOK_RATE_LIMIT=60
# INSTAGRAM_RATE_LIMIT=200
# FACEBOOK_RATE_LIMIT=200
# TWITTER_RATE_LIMIT=900
# LINKEDIN_RATE_LIMIT=50
# THREADS_RATE_LIMIT=60
# SNAPCHAT_RATE_LIMIT=100
# PINTEREST_RATE_LIMIT=200

# =============================================================================
# Next.js Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_VERSION=1.0.0

# =============================================================================
# Tauri Desktop Configuration
# =============================================================================
TAURI_APP_NAME=ClipForge
TAURI_APP_VERSION=1.0.0
TAURI_APP_AUTHOR=YourName
TAURI_APP_DESCRIPTION=A unified content pipeline tool for creators
